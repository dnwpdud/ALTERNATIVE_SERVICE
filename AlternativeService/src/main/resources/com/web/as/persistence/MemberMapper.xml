<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.web.as.persistence.MemberMapper">

    <!-- Result Map -->
    <resultMap id="memberResultMap" type="com.web.as.domain.MemberVO">
        <id property="memberId" column="MEMBER_ID"/>
        <result property="crewId" column="CREW_ID"/>
        <result property="memberUid" column="MEMBER_UID"/>
        <result property="memberPw" column="MEMBER_PW"/>
        <result property="memberName" column="MEMBER_NAME"/>
        <result property="memberEmail" column="MEMBER_EMAIL"/>
        <result property="memberPhone" column="MEMBER_PHONE"/>
        <result property="memberRegDate" column="MEMBER_REG_DATE"/>
        <result property="memberAuth" column="MEMBER_AUTH"/>
        <result property="enabled" column="ENABLED"/>
    </resultMap>
    
    <!-- ========================= -->
    <!-- ResultMap : 컬럼 ↔ VO 매핑 -->
    <!-- ========================= -->
    
    <resultMap id="memberRoleMap" type="com.web.as.domain.MemberRoleVO">
        <id property="roleId" column="ROLE_ID"/>
        <result property="memberId" column="MEMBER_ID"/>
        <result property="roleName" column="ROLE_NAME"/>
    </resultMap>
    

    <!-- Create -->
    <insert id="insertMember" parameterType="com.web.as.domain.MemberVO" useGeneratedKeys="true" keyProperty="memberId">
        INSERT INTO MEMBER (MEMBER_SEQ.NEXTVAL,CREW_ID, MEMBER_UID, MEMBER_PW, MEMBER_NAME, MEMBER_EMAIL, MEMBER_PHONE)
        VALUES (#{crewId}, #{memberUid}, #{memberPw}, #{memberName}, #{memberEmail}, #{memberPhone})
    </insert>

    <!-- Read by ID -->
    <select id="getMemberById" parameterType="long" resultMap="memberResultMap">
        SELECT * FROM MEMBER WHERE MEMBER_ID = #{memberId}
    </select>

    <!-- Read All -->
    <select id="getAllMembers" resultMap="memberResultMap">
        SELECT * FROM MEMBER ORDER BY MEMBER_ID
    </select>

    <!-- Update by ID -->
    <update id="updateMember" parameterType="com.web.as.domain.MemberVO">
        UPDATE MEMBER
        SET CREW_ID = #{crewId},
            MEMBER_UID = #{memberUid},
            MEMBER_PW = #{memberPw},
            MEMBER_NAME = #{memberName},
            MEMBER_EMAIL = #{memberEmail},
            MEMBER_PHONE = #{memberPhone},
            MEMBER_AUTH = #{memberAuth},
            ENABLED = #{enabled}
        WHERE MEMBER_ID = #{memberId}
    </update>

    <!-- Delete by ID -->
    <delete id="deleteMember" parameterType="long">
        DELETE FROM MEMBER WHERE MEMBER_ID = #{memberId}
    </delete>

	<!-- ============================================================== -->
	
	<!-- ========================= -->
    <!-- 권한 등록 -->
    <!-- ========================= -->
    <insert id="insertMemberRole">
        INSERT INTO MEMBER_ROLE (
            ROLE_ID,
            MEMBER_ID,
            ROLE_NAME
        ) VALUES (
            #{roleId},
            #{memberId},
            #{roleName}
        )
    </insert>

    <!-- ========================= -->
    <!-- 회원 ID로 권한 조회 -->
    <!-- ========================= -->
    <select id="selectRolesByMemberId"
            parameterType="string"
            resultMap="memberRoleMap">
        SELECT
            ROLE_ID,
            MEMBER_ID,
            ROLE_NAME
        FROM MEMBER_ROLE
        WHERE MEMBER_ID = #{memberId}
    </select>

    <!-- ========================= -->
    <!-- ROLE_ID로 단건 조회 -->
    <!-- ========================= -->
    <select id="selectRoleByRoleId"
            parameterType="long"
            resultMap="memberRoleMap">
        SELECT
            ROLE_ID,
            MEMBER_ID,
            ROLE_NAME
        FROM MEMBER_ROLE
        WHERE ROLE_ID = #{roleId}
    </select>

    <!-- ========================= -->
    <!-- 권한 삭제 (ROLE_ID 기준) -->
    <!-- ========================= -->
    <delete id="deleteMemberRole">
        DELETE FROM MEMBER_ROLE
        WHERE ROLE_ID = #{roleId}
    </delete>

    <!-- ========================= -->
    <!-- 특정 회원 권한 전체 삭제 -->
    <!-- ========================= -->
    <delete id="deleteRolesByMemberId">
        DELETE FROM MEMBER_ROLE
        WHERE MEMBER_ID = #{memberId}
    </delete>
	
</mapper>