&lt;li&gt;&lt;a href=&quot;https://github.com/spring-projects/spring-security/releases/tag/7.0.0-RC2&quot;&gt;&lt;code&gt;7.0.0-RC2&lt;/code&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;https://github.com/spring-projects/spring-security/releases/tag/7.0.0-RC3&quot;&gt;&lt;code&gt;7.0.0-RC3&lt;/code&gt;&lt;/a&gt;&lt;/li&gt;
