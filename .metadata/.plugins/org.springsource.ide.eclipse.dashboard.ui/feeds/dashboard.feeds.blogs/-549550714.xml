&lt;li&gt;&lt;a href=&quot;https://github.com/spring-projects/spring-security/releases/tag/7.0.0-M2&quot;&gt;&lt;code&gt;7.0.0-M2&lt;/code&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;https://github.com/spring-projects/spring-security/releases/tag/7.0.0-M3&quot;&gt;&lt;code&gt;7.0.0-M3&lt;/code&gt;&lt;/a&gt;&lt;/li&gt;
