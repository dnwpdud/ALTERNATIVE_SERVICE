package com.web.as.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.web.as.domain.MemberRoleVO;
import com.web.as.domain.MemberVO;
import com.web.as.persistence.MemberMapper;
import com.web.as.persistence.OutingMapper;

import lombok.extern.log4j.Log4j;

@Service
@Log4j
public class MemberServiceImpl implements MemberService {
	
	@Autowired
	private MemberMapper memberMapper;
	
	@Override
	public int createMember(MemberVO memberVO) {
		log.info("createBoard()");
		log.info("memberVO = " + memberVO);
		int insertMemverResult = memberMapper.insertMember(memberVO);
		log.info(insertMemverResult + "행 게시글 등록");
		return insertMemverResult;
	}

	@Override
	public MemberVO readMember(int memberId) {
		return memberMapper.getMemberById(memberId);
	}

	@Override
	public List<MemberVO> readAllMembers() {
		return memberMapper.getAllMembers();
	}

	@Override
	public int updateMember(MemberVO member) {
		return memberMapper.updateMember(member);
	}

	@Override
	public int deleteMember(int memberId) {
		int deleteMemberResult = memberMapper.deleteMember(memberId);
		return deleteMemberResult;
	}

	@Override
    public void registerMemberRole(MemberRoleVO vo) {
        log.info("registerMemberRole : " + vo);
        memberMapper.insertMemberRole(vo);
    }

    /**
     * 회원 ID 기준 권한 목록 조회
     */
    @Override
    public List<MemberRoleVO> getRolesByMemberId(String memberId) {
        log.info("getRolesByMemberId : " + memberId);
        return memberMapper.selectRolesByMemberId(memberId);
    }

    /**
     * ROLE_ID 기준 권한 단건 조회
     */
    @Override
    public MemberRoleVO getRoleByRoleId(int roleId) {
        log.info("getRoleByRoleId : " + roleId);
        return memberMapper.selectRoleByRoleId(roleId);
    }

    /**
     * ROLE_ID 기준 권한 삭제
     */
    @Override
    public void removeMemberRole(int roleId) {
        log.info("removeMemberRole : " + roleId);
        memberMapper.deleteMemberRole(roleId);
    }

    /**
     * 회원 ID 기준 권한 전체 삭제
     */
    @Override
    public void removeRolesByMemberId(String memberId) {
        log.info("removeRolesByMemberId : " + memberId);
        memberMapper.deleteRolesByMemberId(memberId);
    }

}
