package com.web.as.persistence;

import java.util.List;

import org.apache.ibatis.annotations.Mapper;

import com.web.as.domain.MemberVO;

@Mapper
public interface MemberMapper {
	int insertMember(MemberVO member);
    MemberVO getMemberById(int memberId);
    List<MemberVO> getAllMembers();
    int updateMember(MemberVO member);
    int deleteMember(int memberId);
    
    /**
     * 회원 권한 등록
     *
     * @param vo 회원 권한 정보 VO
     *           (ROLE_ID, MEMBER_ID, ROLE_NAME)
     */
    void insertMemberRole(MemberRoleVO vo);

    /**
     * 회원 ID 기준 권한 목록 조회
     *
     * @param memberId 회원 로그인 ID
     * @return 해당 회원이 가진 권한 목록
     */
    List<MemberRoleVO> selectRolesByMemberId(String memberId);

    /**
     * ROLE_ID 기준 권한 단건 조회
     *
     * @param roleId 권한 고유 ID (PK)
     * @return 권한 정보 VO
     */
    MemberRoleVO selectRoleByRoleId(Long roleId);

    /**
     * ROLE_ID 기준 권한 삭제
     *
     * @param roleId 권한 고유 ID (PK)
     */
    void deleteMemberRole(Long roleId);

    /**
     * 회원 ID 기준 권한 전체 삭제
     *
     * @param memberId 회원 로그인 ID
     */
    void deleteRolesByMemberId(String memberId);
}
