package com.web.as.service;

import java.util.List;

import com.web.as.domain.MemberRoleVO;
import com.web.as.domain.MemberVO;


public interface MemberService {
	int createMember(MemberVO member);
    MemberVO readMember(int memberId);
    List<MemberVO> readAllMembers();
    int updateMember(MemberVO member);
    int deleteMember(int memberId);
    
    /**
     * 회원 권한 등록
     *
     * @param vo 회원 권한 정보
     */
    void registerMemberRole(MemberRoleVO vo);

    /**
     * 회원 ID 기준 권한 목록 조회
     *
     * @param memberId 회원 로그인 ID
     * @return 권한 목록
     */
    List<MemberRoleVO> getRolesByMemberId(String memberId);

    /**
     * ROLE_ID 기준 권한 단건 조회
     *
     * @param roleId 권한 고유 ID
     * @return 권한 정보
     */
    MemberRoleVO getRoleByRoleId(Long roleId);

    /**
     * ROLE_ID 기준 권한 삭제
     *
     * @param roleId 권한 고유 ID
     */
    void removeMemberRole(Long roleId);

    /**
     * 회원 ID 기준 권한 전체 삭제
     *
     * @param memberId 회원 로그인 ID
     */
    void removeRolesByMemberId(String memberId);
}
