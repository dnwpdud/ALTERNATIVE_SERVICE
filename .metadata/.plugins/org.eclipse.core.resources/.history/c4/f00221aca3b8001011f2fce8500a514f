package com.web.as.controller;

import java.util.List;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;

import com.web.as.domain.MemberVO;
import com.web.as.service.MemberService;

import lombok.extern.log4j.Log4j;

@Controller
@RequestMapping(value = "/member") 
@Log4j
public class MemberController {
	private MemberService memberService;
	
	@PostMapping
    public String addMember(@RequestBody MemberVO memberVO) {
        memberService.createMember(memberVO);
        return "Member created successfully";
    }
	
	@GetMapping("/detail")
    public MemberVO getMember(Model model, Integer memberId) {
        return memberService.readMember(memberId);
    }
	
	@GetMapping("/list")
    public List<MemberVO> getAllMembers(Model model, ) {
        return memberService.readAllMembers();
    }
	
	@PutMapping("/updata")
	public String updateMember(@RequestBody MemberVO memberVO) {
		memberVO.setMemberId(memberVO.getMemberId());
	    memberService.updateMember(memberVO);
	    return "Member updated successfully";
	}
}
